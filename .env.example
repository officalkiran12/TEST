# ==========================================================================
# GLOBAL JOB SEARCH AGGREGATOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================================

# 1. DATABASE CONFIGURATION
# Defaults to a local SQLite 'jobs.db' if left blank or failed.
# Set a PostgreSQL connection string for production deployments:
# DATABASE_URL=postgresql://postgres:secretpassword@localhost:5432/job_finder_db

# 2. CRAWLER CONTROLS
SCRAPE_INTERVAL_MINUTES=60
MAX_SCRAPE_JOBS_PER_SOURCE=30

# 3. RATE LIMITING MIDDLEWARE
RATE_LIMIT_CALLS=60
RATE_LIMIT_PERIOD_SECONDS=60

# 4. TELEGRAM BOT NOTIFICATION ALERTS
# Go to @BotFather on Telegram to generate a token, and fetch your chat ID
# TELEGRAM_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890

# 5. ADMIN EMAIL DISPATCH ALERTS (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@globaljobsengine.io
# SMTP_PASS=appspecificpasscode
# ALERT_EMAIL=admin@globaljobsengine.io
